# Settings for the docker/ test stack. Copy to docker/.env, or let
# `docker/fa-api init` write one with ports that are free on this machine.
#
# Every value here is a default that docker/fa-api already applies — this file
# exists to show what can be changed, not because anything must be.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Containers and the database volume are named after this. It defaults to
# fa-api-<checkout directory name>, which is what keeps a worktree's stack
# separate from the main checkout's.
#COMPOSE_PROJECT_NAME=fa-api-api

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------

# Clear of the FrontAccounting stack's 8080/3307/8081, so both can run at once.
# Inside the container Apache is always on 8000 — the suite asks for it by name.
#HTTP_PORT=8090
#DB_PORT=3309
#PMA_PORT=8091

# ---------------------------------------------------------------------------
# FrontAccounting
# ---------------------------------------------------------------------------

# The application this module plugs into, cloned into the image at build time.
# Point it at a fork to test against one:
#
#   FA_REPO=https://github.com/cambell-prince/frontaccounting.git
#   FA_REF=master-cp
#
# A shallow clone needs a branch or a tag; a bare commit sha will not work.
# Changing either needs `docker/fa-api up --build`.
#FA_REPO=https://github.com/FrontAccountingERP/FA.git
#FA_REF=master

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------

# Any version sury publishes for Debian trixie: 7.4, 8.0 ... 8.4.
#
# This module's master targets PHP 5.6/7.0 (the .travis.yml matrix) and
# FrontAccounting 2.4.x is written against 5.4-7.x, so 7.4 is the newest either
# is known to run on, and what CI gates on. 8.x is where feature/php8 is going:
# Slim 2 and phpunit 4 do not run there, which is the point of the branch.
#PHP_VERSION=7.4

#MARIADB_VERSION=10.11

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The entrypoint writes these into FrontAccounting's config_db.php on every
# start. The suite authenticates over HTTP as company 0, test / test — that
# account comes from the dataset, not from here.
#DB_NAME=fa_test
#DB_USER=fa
#DB_PASSWORD=fa
#DB_ROOT_PASSWORD=fa

# The table prefix. Datasets ship with 0_ baked in; anything else is rewritten
# as it loads.
#DB_PREFIX=0_

# What `fa-api up` loads into an empty database, and the default for
# `fa-api db reset`: test, test-2.3, new or demo.
#SEED=test

# ---------------------------------------------------------------------------
# PHP
# ---------------------------------------------------------------------------

# Leave xdebug off unless you are attaching to it — it costs real time on every
# request. "debug" enables step debugging on port 9003, triggered by
# XDEBUG_TRIGGER; "coverage" is what phpunit --coverage-html needs.
#
# docker/fa-api folds "develop" into whatever you set, because FA calls
# xdebug_call_file() and xdebug 3 only provides it in that mode. Setting "debug"
# here gives you "develop,debug".
#XDEBUG_MODE=off

# The extension is compiled in unless this is false at build time.
#INSTALL_XDEBUG=true

#FA_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Host user
# ---------------------------------------------------------------------------

# Apache and composer run as www-data remapped to these, so vendor/ and anything
# else written into the bind-mounted checkout stays yours. docker/fa-api fills
# them in from `id -u`/`id -g`.
#USER_UID=1000
#USER_GID=1000
